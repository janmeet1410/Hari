{
  "$schema": "https://developer.microsoft.com/json-schemas/spfx-build/config.2.0.schema.json",
  "version": "2.0",
  "bundles": {
    "banner-web-part": {
      "components": [
        {
          "entrypoint": "./lib/webparts/banner/BannerWebPart.js",
          "manifest": "./src/webparts/banner/BannerWebPart.manifest.json"
        }
      ]
    },
    "products-page-web-part": {
      "components": [
        {
          "entrypoint": "./lib/webparts/productsPage/ProductsPageWebPart.js",
          "manifest": "./src/webparts/productsPage/ProductsPageWebPart.manifest.json"
        }
      ]
    },
    "insight-page-web-part": {
      "components": [
        {
          "entrypoint": "./lib/webparts/insightPage/InsightPageWebPart.js",
          "manifest": "./src/webparts/insightPage/InsightPageWebPart.manifest.json"
        }
      ]
    }
  },
  "externals": {},
  "localizedResources": {
    "BannerWebPartStrings": "lib/webparts/banner/loc/{locale}.js",
    "ProductsPageWebPartStrings": "lib/webparts/productsPage/loc/{locale}.js",
    "InsightPageWebPartStrings": "lib/webparts/insightPage/loc/{locale}.js",
    "ControlStrings": "node_modules/@pnp/spfx-controls-react/lib/loc/{locale}.js",
    "PropertyControlStrings": "node_modules/@pnp/spfx-property-controls/lib/loc/{locale}.js"
  }
}